{
  "name": "replaylab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:services && pnpm build:web",
    "start": "node services-dist/apps/api/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write components/replaylab packages apps tests docs",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:client": "prisma generate",
    "build:services": "node scripts/build-services.mjs",
    "start:api": "node services-dist/apps/api/src/server.js",
    "start:worker": "node services-dist/apps/worker/src/worker.js",
    "dev:full": "node scripts/dev.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.3",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "input-otp": "^1.4.2",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "undici": "^8.10.2",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^3.2.7",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/worker",
    "packages/core"
  ]
}
